+import org.joml.Matrix4fc;
 import org.joml.Vector3f;
 
 import java.util.Arrays;
@@ -55,6 +56,25 @@ public class Viewport {
         setH(Mth.ceil(height * guiScale));
     }
 
+    public void calculateOpenGLViewportFromRectangle(Matrix4fc pose, int x, int y, int width, int height) {
+        Window window = Minecraft.getInstance().getWindow();
+        calculateTransformedViewport(pose, x, y, width, height, window.getGuiScale(), window.getHeight());
+    }
+
+    void calculateTransformedViewport(Matrix4fc pose, int x, int y, int width, int height,
+                                      double guiScale, int framebufferHeight) {
+        Vector3f start = pose.transformPosition(x, y, 0, new Vector3f());
+        Vector3f end = pose.transformPosition(x + width, y + height, 0, new Vector3f());
+        int left = Mth.floor(Math.min(start.x, end.x) * guiScale);
+        int top = Mth.floor(Math.min(start.y, end.y) * guiScale);
+        int right = Mth.ceil(Math.max(start.x, end.x) * guiScale);
+        int bottom = Mth.ceil(Math.max(start.y, end.y) * guiScale);
+        setX(left);
+        setY(framebufferHeight - bottom);
+        setW(right - left);
+        setH(bottom - top);
+    }
+
     public void applyViewport() {
         RenderSystem.viewport(getX(), getY(), getW(), getH());
     }
