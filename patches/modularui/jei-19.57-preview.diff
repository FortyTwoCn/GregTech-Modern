diff --git a/src/test/java/brachy/modularui/drawable/schema/ViewportTest.java b/src/test/java/brachy/modularui/drawable/schema/ViewportTest.java
new file mode 100644
--- /dev/null
+++ b/src/test/java/brachy/modularui/drawable/schema/ViewportTest.java
@@ -0,0 +1,32 @@
+package brachy.modularui.drawable.schema;
+
+import org.joml.Matrix4f;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+
+class ViewportTest {
+
+    @Test
+    void includesHostTranslationAndWidgetPosition() {
+        Viewport viewport = new Viewport();
+        Matrix4f pose = new Matrix4f().translate(300, 100, 0).translate(27, 40, 0);
+        viewport.calculateTransformedViewport(pose, 0, 0, 200, 180, 2, 1080);
+        assertArrayEquals(new int[] {654, 440, 400, 360}, viewport.getViewport());
+    }
+
+    @Test
+    void includesHostScaleAndDrawablePadding() {
+        Viewport viewport = new Viewport();
+        Matrix4f pose = new Matrix4f().translate(300, 100, 0).scale(0.5f);
+        viewport.calculateTransformedViewport(pose, 4, 6, 200, 180, 2, 1080);
+        assertArrayEquals(new int[] {604, 694, 200, 180}, viewport.getViewport());
+    }
+
+    @Test
+    void standaloneScreenKeepsItsViewport() {
+        Viewport viewport = new Viewport();
+        viewport.calculateTransformedViewport(new Matrix4f(), 10, 20, 200, 180, 3, 1080);
+        assertArrayEquals(new int[] {30, 480, 600, 540}, viewport.getViewport());
+    }
+}
